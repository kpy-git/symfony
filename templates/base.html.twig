<!doctype html>
<html lang="es">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}App - Kompymascotas{% endblock %}</title>

    <link rel="icon" href="{{ asset('favicon.ico') }}" sizes="any">
    <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
    <link rel="apple-touch-icon" href="{{ asset('apple-touch-icon.png') }}">

    {% block stylesheets %}{% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}

</head>
<body>
{% block body %}
    <div class="app-layout">
        <header class="app-header">
            <button
                type="button"
                class="header-sidebar-toggle"
                aria-label="Mostrar menú"
                aria-expanded="true"
            >
                <i class="fa-solid fa-bars" aria-hidden="true"></i>
            </button>

            <a href="{{ path('app_index') }}" class="header-brand">
                <img src="{{ asset('images/logo-kompy.svg') }}" alt="Kompymascotas">
            </a>

            {# GLOBAL SEARCH #}
            <div class="header-search">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                <input type="search" placeholder="Buscar..." aria-label="Buscar">
            </div>

            {# HEADER ACTIONS #}
            <div class="header-actions">

                <button type="button" class="header-icon" aria-label="Notificaciones">
                    <i class="fa-regular fa-bell" aria-hidden="true"></i>
                    <span class="notification-count">0</span>
                </button>

                <div class="header-divider"></div>

                <div class="user-dropdown">

                    <button
                        type="button"
                        class="user-menu"
                        aria-haspopup="true"
                        aria-expanded="false"
                        aria-controls="user-dropdown-menu"
                    >
                        <img src="{{ asset('images/avatars/admin.svg') }}" alt="{{ app.user.userIdentifier }}">

                        <span class="user-info">
            <strong>{{ app.user.userIdentifier }}</strong>
        </span>

                        <i class="fa-solid fa-chevron-down user-chevron" aria-hidden="true"></i>
                    </button>

                    <div class="user-dropdown-menu" id="user-dropdown-menu">

                        <div class="user-dropdown-header">
                            <img src="{{ asset('images/avatars/admin.svg') }}" alt="{{ app.user.userIdentifier }}">

                            <div>
                                <strong>{{ app.user.fullname }}</strong>
                                <span>Administración</span>
                            </div>
                        </div>

                        <div class="user-dropdown-divider"></div>

                        <a href="{{ path('app_logout') }}" class="user-dropdown-item logout">
                            <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
                            <span>Cerrar sesión</span>
                        </a>

                    </div>

                </div>

            </div>
        </header>

        <aside class="app-sidebar">
            {% set currentRoute = app.request.attributes.get('_route') %}
            <nav class="sidebar-navigation" aria-label="Navegación principal">
                {# INICIO #}
                <a href="{{ path('app_index') }}" class="nav-item {{ currentRoute == 'app_index' ? 'active': '' }}">
                    <i class="fa-solid fa-house" aria-hidden="true"></i>
                    <span>Inicio</span>
                </a>

                {# TIENDA #}
                <div class="nav-section">
                    <span class="nav-section-title">Tienda</span>

                    {# PEDIDOS #}
                    <details class="nav-group" {{ currentRoute starts with 'warehouse_' ? 'open' : '' }}>
                        <summary class="nav-item">
                            <i class="fa-solid fa-warehouse" aria-hidden="true"></i>
                            <span>Pedidos</span>
                            <i class="fa-solid fa-chevron-down nav-chevron" aria-hidden="true"></i>
                        </summary>

                        <div class="nav-submenu">
                            <a href="{{ path('warehouse_fulfillment') }}" target="_blank">Preparación de pedidos</a>
                        </div>
                    </details>

                    <details class="nav-group" {{ currentRoute starts with 'warehouse_' ? 'open' : '' }}>
                        <summary class="nav-item">
                            <i class="fa-solid fa-cart-shopping" aria-hidden="true"></i>
                            <span>Compras</span>
                            <i class="fa-solid fa-chevron-down nav-chevron" aria-hidden="true"></i>
                        </summary>

                        <div class="nav-submenu">
                            <a href="{{ path('warehouse_prebuy_list') }}" class="nav-item {{ currentRoute == 'warehouse_prebuy_list' ? 'active': '' }}">Precompra</a>
                            <a href="{{ path('warehouse_proposal_index') }}" class="nav-item {{ currentRoute == 'warehouse_proposal_index' ? 'active': '' }}">Propuesta de compra</a>
                        </div>
                    </details>


                {% if is_granted('ROLE_ROOT') %}
                    <details class="nav-group">
                        <summary class="nav-item">
                            <i class="fa-solid fa-box" aria-hidden="true"></i>
                            <span>Productos</span>
                            <i class="fa-solid fa-chevron-down nav-chevron" aria-hidden="true"></i>
                        </summary>

                        <div class="nav-submenu">
                            <a href="#">Todos los productos</a>
                            <a href="#">Inventario</a>
                            <a href="#">Atributos</a>
                            <a href="#">Marcas</a>
                        </div>
                    </details>


                    <details class="nav-group">
                        <summary class="nav-item">
                            <i class="fa-solid fa-users" aria-hidden="true"></i>
                            <span>Clientes</span>
                            <i class="fa-solid fa-chevron-down nav-chevron" aria-hidden="true"></i>
                        </summary>

                        <div class="nav-submenu">
                            <a href="#">Todos los clientes</a>
                            <a href="#">Segmentos</a>
                            <a href="#">Grupos</a>
                        </div>
                    </details>
                </div>


                <div class="nav-section">
                    <span class="nav-section-title">Marketing</span>

                    <details class="nav-group">
                        <summary class="nav-item">
                            <i class="fa-solid fa-percent" aria-hidden="true"></i>
                            <span>Descuentos</span>
                            <i class="fa-solid fa-chevron-down nav-chevron" aria-hidden="true"></i>
                        </summary>

                        <div class="nav-submenu">
                            <a href="#">Reglas de descuento</a>
                            <a href="#">Cupones</a>
                        </div>
                    </details>


                    <details class="nav-group">
                        <summary class="nav-item">
                            <i class="fa-solid fa-bullhorn" aria-hidden="true"></i>
                            <span>Promociones</span>
                            <i class="fa-solid fa-chevron-down nav-chevron" aria-hidden="true"></i>
                        </summary>

                        <div class="nav-submenu">
                            <a href="#">Campañas</a>
                            <a href="#">Promociones activas</a>
                        </div>
                    </details>

                </div>


                <div class="nav-section">
                    <span class="nav-section-title">Analítica</span>

                    <details class="nav-group">
                        <summary class="nav-item">
                            <i class="fa-solid fa-chart-line" aria-hidden="true"></i>
                            <span>Informes</span>
                            <i class="fa-solid fa-chevron-down nav-chevron" aria-hidden="true"></i>
                        </summary>

                        <div class="nav-submenu">
                            <a href="#">Ventas</a>
                            <a href="#">Clientes</a>
                            <a href="#">Inventario</a>
                        </div>
                    </details>

                </div>



                {# SISTEMA #}
                    <div class="nav-section">
                        <span class="nav-section-title">Sistema</span>

                        <details class="nav-group">
                            <summary class="nav-item">
                                <i class="fa-solid fa-gear" aria-hidden="true"></i>
                                <span>Configuración</span>
                                <i class="fa-solid fa-chevron-down nav-chevron" aria-hidden="true"></i>
                            </summary>

                            <div class="nav-submenu">
                                <a href="#">Usuarios</a>
                                <a href="#">Permisos</a>
                            </div>
                        </details>
                    </div>
                {% endif %}
            </nav>

            <div class="sidebar-footer">
                <button type="button" class="footer-sidebar-toggle" aria-label="Contraer menú">
                    <span>Contraer el menú</span>
                    <i class="fa-solid fa-angles-left collapse-icon" aria-hidden="true"></i>
                </button>
            </div>
        </aside>

        <main class="app-main">
            {% block content %}{% endblock %}
        </main>
    </div>

    <div id="app-modal" class="app-modal" aria-hidden="true">
        <div class="app-modal__backdrop"></div>

        <div class="app-modal__dialog"
             role="dialog"
             aria-modal="true"
             aria-labelledby="app-modal-title"
             aria-describedby="app-modal-message">

            <div class="app-modal__header">
                <h3 id="app-modal-title"></h3>

                <button type="button"
                        class="app-modal__close"
                        aria-label="Cerrar">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="app-modal__content">
                <div class="app-modal__icon" id="app-modal-icon"></div>
                <div id="app-modal-message"></div>
            </div>

            <div class="app-modal__footer">
                <button type="button"
                        class="btn btn-secondary app-modal__cancel">
                    Cerrar
                </button>

                <button type="button"
                        class="btn btn-primary app-modal__accept">
                    Aceptar
                </button>
            </div>

        </div>
    </div>

    <div id="modal-loading" class="loading-modal" aria-hidden="true">
        <div class="loading-modal__backdrop"></div>

        <div class="loading-modal__dialog"
             role="dialog"
             aria-modal="true"
             aria-label="Cargando">

            <div class="loading-modal__spinner"></div>

        </div>
    </div>
{% endblock %}
</body>
</html>
