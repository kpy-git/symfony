{# Valores por defecto #}
{% set type = type|default('text') %}
{% set inputId = id|default(name|default('')) %}
{% set passwordToggle = type == 'password' and password_toggle|default(false) %}

<div class="input-wrapper">

    {# Icono izquierdo #}
    {% if icon|default(null) %}
        <span class="input-icon" aria-hidden="true">

            {% if icon == 'user' %}
                <svg viewBox="0 0 24 24" fill="none">
                    <circle cx="12" cy="8" r="4"
                            stroke="currentColor" stroke-width="1.8"/>
                    <path d="M4 21C4 16.8 7.6 14 12 14C16.4 14 20 16.8 20 21"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"/>
                </svg>

            {% elseif icon == 'lock' %}
                <svg viewBox="0 0 24 24" fill="none">
                    <rect x="4" y="10" width="16" height="11" rx="2"
                          stroke="currentColor" stroke-width="1.8"/>
                    <path d="M8 10V7a4 4 0 0 1 8 0v3"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"/>
                </svg>
            {% endif %}

        </span>
    {% endif %}


    {# Input #}
    <input
        type="{{ type }}"
        id="{{ inputId }}"
        name="{{ name }}"
        class="form-input{% if passwordToggle %} form-input--password{% endif %}"
        placeholder="{{ placeholder|default('') }}"
        value="{{ value|default('') }}"
        {% if autocomplete|default(null) %}
            autocomplete="{{ autocomplete }}"
        {% endif %}
        {% if autofocus|default(false) %}autofocus{% endif %}
        {% if required|default(false) %}required{% endif %}
        {% if disabled|default(false) %}disabled{% endif %}
        {% if readonly|default(false) %}readonly{% endif %}
        {% if inputmode|default(null) %}
            inputmode="{{ inputmode }}"
        {% endif %}
        {% if maxlength|default(null) %}
            maxlength="{{ maxlength }}"
        {% endif %}
        {% if error|default(null) %}
            aria-invalid="true"
            aria-describedby="{{ inputId }}-error"
        {% endif %}
    >


    {# Mostrar / ocultar contraseña #}
    {% if passwordToggle %}
        <button
            type="button"
            class="input-password-toggle"
            data-password-toggle
            aria-label="Mostrar contraseña"
            aria-pressed="false"
            aria-controls="{{ inputId }}"
        >
            {# Icono ojo #}
            <svg class="icon-eye" viewBox="0 0 24 24" fill="none">
                <path
                    d="M2 12S5.5 5 12 5S22 12 22 12S18.5 19 12 19S2 12 2 12Z"
                    stroke="currentColor"
                    stroke-width="1.8"
                />
                <circle cx="12" cy="12" r="3"
                        stroke="currentColor" stroke-width="1.8"/>
            </svg>

            {# Icono ojo tachado #}
            <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none">
                <path
                    d="M3 3L21 21"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                />
                <path
                    d="M10.6 5.2C11.1 5.1 11.5 5 12 5C18.5 5 22 12 22 12S20.8 14.4 18.6 16.3M6.2 6.2C3.5 8.1 2 12 2 12S5.5 19 12 19C13.6 19 15 18.6 16.2 17.9"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                />
            </svg>
        </button>
    {% endif %}

</div>
