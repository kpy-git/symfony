
{% extends 'base.html.twig' %}

{% block title %}Ha ocurrido un error{% endblock %}

{% block body %}
    <main class="error-page">
        <div class="error-content">
            <div class="error-icon">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>

            <h1>¡Vaya! Algo no ha salido como esperábamos</h1>

            {% include 'components/_message.html.twig' with {
                type: 'error',
                message: errorMessage|default('Ha ocurrido un error inesperado. Por favor, inténtalo de nuevo.'),
            } %}
        </div>
    </main>
{% endblock %}
