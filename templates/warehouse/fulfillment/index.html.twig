<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Preparación de pedidos{% endblock %}</title>
    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap(['app', 'warehouse-fulfillment']) }}{% endblock %}
    {% endblock %}

</head>
<body>

<header>
    <span>Pedidos pendientes de preparar</span>
    {% if warehouse == 'EVOLUTION_PETS' %}
        <button id="btn__manifest">Manifiesto de carga</button>
    {% endif %}
</header>

<div class="contenedor-principal">

    <!-- Columna Izquierda: Listado -->
    <div class="columna-izquierda" id="listaPedidos" data-warehouse="{{ warehouse }}">
        {% for order in pendingOrders %}
            {{ include('warehouse/fulfillment/_order-preview.html.twig', {orderId: order.id_order, orderDate: order.date_add|date("d/m/Y H:i")}) }}
        {% endfor %}
    </div>

    <!-- Columna Derecha: Detalle -->
    <div class="columna-derecha" id="panelDetalle">
        <div class="vista-vacia">
            Selecciona un pedido de la lista para ver sus detalles.
        </div>
    </div>
</div>
<script id="printer-config" type="application/json">
    {{ printer_config|json_encode|raw }}
</script>
</body>
</html>
