services:
    nginx:
        container_name: sf-kompy-nginx
        image: nginx:stable-alpine
        ports:
            - "8000:80"
            - "443:443"
        volumes:
            - ./:${APP_PATH}
            - ./.docker/nginx.conf:/etc/nginx/conf.d/default.conf
            - ./.docker/certs:/etc/nginx/certs:ro
        networks:
            - kompy-net
        restart: always

    php:
        container_name: sf-kompy-php
        build:
            context: .docker/
            args:
                UID: ${U_ID}
                APP_PATH: ${APP_PATH}
        volumes:
            - ./:${APP_PATH}
            - .docker/custom-fpm.conf:/usr/local/etc/php-fpm.d/z-custom-fpm.conf:ro
            - .docker/custom-php.ini:/usr/local/etc/php/conf.d/z-custom-php.ini:ro
        user: ${U_ID}
        networks:
            - kompy-net
        environment:
            PHP_IDE_CONFIG: serverName=sf-kompy
        extra_hosts:
            - host.docker.internal:host-gateway
        restart: always

networks:
    kompy-net:
